NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/shopstock?replicaSet=rs0
APP_URL=http://localhost:5173
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-48-random-bytes-base64url-at-least-32-chars
# The password of every demo login the seed creates (npm run seed). Never commit the real one.
SEED_DEMO_PASSWORD=change-me-demo-123
# Public demo only: @demo.shopstock.dev logins can run the shop but not change passwords or the shop setup.
# DEMO_MODE=true
